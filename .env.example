# OPERA local development environment
FLASK_ENV=development
ENABLE_LEGACY_MODULES=false
SECRET_KEY=change-this-for-shared-environments
# DATABASE_URL=sqlite:///instance/opera.db
LOG_LEVEL=INFO
SESSION_COOKIE_SECURE=false

# Optional: configure to enable secure TOTP recovery emails
# PUBLIC_BASE_URL=http://127.0.0.1:5000
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# MAIL_FROM=

# Local Docker Compose database only; do not reuse in production.
POSTGRES_USER=opera_dev
POSTGRES_PASSWORD=opera_local_only
POSTGRES_DB=opera_dev
