# syntax=docker/dockerfile:1.7
FROM python:3.12-alpine AS builder
ENV PIP_DISABLE_PIP_VERSION_CHECK=1 PYTHONDONTWRITEBYTECODE=1
WORKDIR /build
# Install musllinux-compatible dependencies for the Alpine production runtime.
RUN python -m pip install --no-cache-dir --upgrade "pip==26.2.1" "setuptools==84.0.0"
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
FROM python:3.12-alpine AS runtime
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PATH="/opt/venv/bin:$PATH"
WORKDIR /app
RUN apk upgrade --no-cache \
    && addgroup -S -g 10001 opera \
    && adduser -S -D -H -u 10001 -G opera opera
# OPERA production uses PostgreSQL only. Remove SQLite's optional Python module
# and the SQLite runtime package from this minimal Alpine image.
RUN find /usr/local/lib/python3.12 -type f -name '_sqlite3*.so' -delete \
    && (apk info -e sqlite-libs >/dev/null 2>&1 && apk del sqlite-libs || true) \
    && ! apk info -e sqlite-libs
COPY --from=builder /opt/venv /opt/venv
RUN ! python -c "import sqlite3" && python -c "import psycopg2, sqlalchemy; print('PostgreSQL runtime ready')"
COPY . .
RUN chmod 0555 /app/docker/entrypoint.sh && chown -R opera:opera /app
USER opera
EXPOSE 8000
STOPSIGNAL SIGTERM
CMD ["gunicorn","--bind","0.0.0.0:8000","--workers","3","--threads","2","--timeout","120","--graceful-timeout","30","--access-logfile","/dev/null","--error-logfile","-","wsgi:app"]
