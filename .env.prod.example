# OPERA production environment template.
# Copy to .env.prod and replace every placeholder. Never commit .env.prod.

FLASK_ENV=production
SECRET_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
POSTGRES_USER=opera_app
POSTGRES_DB=opera_prod
SESSION_COOKIE_NAME=opera_session
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=Lax
PREFERRED_URL_SCHEME=https
PUBLIC_BASE_URL=https://opera.example.com

# docker-compose.production.yml provides Redis-backed rate limiting.
RATELIMIT_STORAGE_URI=redis://redis:6379/0
RATELIMIT_DEFAULT=300 per minute
LOG_LEVEL=INFO
OTEL_SERVICE_NAME=opera

# Optional account-recovery email. Configure all required values together.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
